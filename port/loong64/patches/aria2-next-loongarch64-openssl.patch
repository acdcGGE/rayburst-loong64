diff --git a/cmake/superbuild/Dependencies.cmake b/cmake/superbuild/Dependencies.cmake
index a75f16a..f702bc0 100644
--- a/cmake/superbuild/Dependencies.cmake
+++ b/cmake/superbuild/Dependencies.cmake
@@ -120,6 +120,11 @@ elseif(WIN32)
   endif()
 elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
   set(ARIA2_OPENSSL_TARGET linux-aarch64)
+elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(loongarch64|loong64)$")
+  # OpenSSL 3.x ships a native LoongArch64 target (Configurations/10-main.conf).
+  # Without this branch the generic fallback selects linux-x86_64 and the
+  # generated build files contain x86_64 assembly that cannot be assembled.
+  set(ARIA2_OPENSSL_TARGET linux64-loongarch64)
 else()
   set(ARIA2_OPENSSL_TARGET linux-x86_64)
 endif()
